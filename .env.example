# EA FC 26 Trading Assistant Configuration
# IMPORTANTE: Este bot NO ejecuta trades automáticamente
# Solo te da RECOMENDACIONES de qué comprar y vender

# 💰 PRESUPUESTO INICIAL: 11,000 COINS
# Este archivo está optimizado para trading con bajo presupuesto

# Database Configuration
DATABASE_URL=sqlite:///data/trading_bot.db

# Trading Settings (OPTIMIZADO PARA 11K COINS)
MIN_PROFIT_MARGIN=10             # Mínimo 10% de ganancia (1,000+ coins)
MAX_BUY_PRICE=9000               # Máximo 9k (deja 2k de margen)
MIN_BUY_PRICE=1500               # Mínimo 1.5k (cartas más baratas no valen la pena)
MAX_INVESTMENT_PER_CARD=5000     # Máximo 5k por carta (diversifica)
RESERVE_COINS=2000               # NUNCA gastes estos 2k (emergencias)

# Bot Configuration
AUTO_TRADING_ENABLED=false       # NO CAMBIAR - El bot no auto-tradea
TRADE_INTERVAL_MINUTES=10        # Analiza cada 10 min (más frecuente para oportunidades)

# Market Analysis
PLAYERS_TO_TRACK=100
PRICE_HISTORY_DAYS=30

# Prediction Model
MODEL_RETRAIN_DAYS=7
PREDICTION_CONFIDENCE_THRESHOLD=0.75

# API Settings
API_PORT=5000
API_HOST=localhost

# Logging
LOG_LEVEL=INFO

# Discord Bot Configuration (optional)
# Get your bot token from: https://discord.com/developers/applications
# Get channel ID by right-clicking channel > Copy ID (enable Developer Mode first)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
DISCORD_DAILY_REPORT_HOUR=9
LOG_FILE=logs/trading_bot.log
